---
# Java-like layout: attached braces, spaces only, 4-column indent.
Language: Cpp
BasedOnStyle: LLVM

# Braces: always `if (...) {`, `} else {`; never on their own line.
BreakBeforeBraces: Attach
# Remove braces around single-statement if/loop bodies (braceless style);
# never insert them.
RemoveBracesLLVM: true
InsertBraces: false

# Indentation and layout
IndentWidth: 4
ContinuationIndentWidth: 8
UseTab: Never
ColumnLimit: 80
# Project convention: two blank lines between top-level function definitions.
# clang-format preserves them via MaxEmptyLinesToKeep but cannot insert them;
# SeparateDefinitionBlocks must stay Leave - Always would collapse the two
# blank lines back to one.
MaxEmptyLinesToKeep: 2
SeparateDefinitionBlocks: Leave
IndentCaseLabels: true
IndentPPDirectives: AfterHash

# Every source file ends with exactly one trailing newline.
InsertNewlineAtEOF: true

# Short constructs: single-statement ifs/loops and short functions collapse
# onto one line.
AllowShortIfStatementsOnASingleLine: AllIfsAndElse
AllowShortLoopsOnASingleLine: true
AllowShortFunctionsOnASingleLine: All
AllowShortBlocksOnASingleLine: Never
AllowShortCaseLabelsOnASingleLine: false
AllowShortEnumsOnASingleLine: false

# Pointers bind to the name: `list_t *list`.
PointerAlignment: Right
DerivePointerAlignment: false
SpaceAfterCStyleCast: true

# Align consecutive assignments, declarations, macros and bit-fields.
AlignConsecutiveAssignments: Consecutive
AlignConsecutiveDeclarations: Consecutive
AlignConsecutiveMacros: Consecutive
AlignConsecutiveBitFields: Consecutive
AlignTrailingComments: true
AlignAfterOpenBracket: Align

# Keep include order as written (order can matter in C).
SortIncludes: Never

# Line breaking
BreakBeforeBinaryOperators: None
AllowAllArgumentsOnNextLine: true
AllowAllParametersOfDeclarationOnNextLine: true
PenaltyBreakBeforeFirstCallParameter: 1
